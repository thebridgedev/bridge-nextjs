# Demo runtime config for E2E tests — PRODUCTION bridge backend.
# Injected by playwright.config.ts's webServer (dotenv-cli) when the project is
# `prod`, i.e. `npm run test:e2e:prod`.
#
# Tracked in git on purpose (TBP-721): no secrets, and a clean checkout has to
# be able to run the prod suite without hand-writing a file first.

# Resolved by e2e/playwright/global-setup.ts and seeded into localStorage as
# `bridge:appId`. Deliberately EMPTY — env wins over the seeded id.
NEXT_PUBLIC_BRIDGE_APP_ID=

# Deliberately EMPTY: the SDK resolves its own production endpoints, which is
# the real user experience this suite measures.
NEXT_PUBLIC_BRIDGE_API_BASE_URL=

NEXT_PUBLIC_BRIDGE_CALLBACK_URL=http://localhost:3010/auth/oauth-callback
NEXT_PUBLIC_BRIDGE_DEBUG=true
NEXT_PUBLIC_DEMO_ENVIRONMENT=prod
