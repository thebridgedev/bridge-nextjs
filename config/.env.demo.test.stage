# Demo runtime config for E2E tests — STAGE bridge backend.
# Injected by playwright.config.ts's webServer (dotenv-cli) when the project is
# `stage`, i.e. `npm run test:e2e:stage`.
#
# Tracked in git on purpose (TBP-721): it holds only public stage endpoints, and
# a clean checkout has to be able to run the stage suite without anyone
# hand-writing a file first. pre-setup no longer writes it.
#
# EVERY key the demo reads is written here, even when the value is empty. A key
# this file leaves out falls back to the SDK's PRODUCTION default
# (https://api.thebridge.dev) — and the stage suite used to boot the demo with
# the LOCAL env file instead, driving the browser at http://localhost:3200 with
# the local slot's app id while test accounts were created on stage. Silence
# here is not "use the stage default"; there is no stage default.

# Resolved by e2e/playwright/global-setup.ts from the stage test-data API and
# seeded into localStorage as `bridge:appId`, which the demo passes to
# BridgeProvider (demo/src/components/demo-app-id.ts). Deliberately EMPTY: the
# SDK merges env over props, so any value here would override the seeded id.
# To serve this demo by hand outside Playwright, put a stage app id here.
NEXT_PUBLIC_BRIDGE_APP_ID=

# The stage API. Auth (`/auth`), cloud views and realtime (`/realtime/config`)
# are all derived from this root by the SDK / auth-core.
NEXT_PUBLIC_BRIDGE_API_BASE_URL=https://api-stage.thebridge.dev

NEXT_PUBLIC_BRIDGE_CALLBACK_URL=http://localhost:3010/auth/oauth-callback
NEXT_PUBLIC_BRIDGE_DEBUG=true

# Shown by the demo's ConfigStatus env pill; global-setup asserts it (and the
# API root above) against the Playwright project.
NEXT_PUBLIC_DEMO_ENVIRONMENT=stage
